{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squares",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      // No database_id: the first deploy creates a database named "squares"
      // and links it. The worker creates its own tables on first use.
      "binding": "DB",
      "database_name": "squares"
    }
  ]
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   HELPER_PIN  passcode helpers type on the tablets
  //   ADMIN_PIN   passcode for the admin screen (keep this one to yourself)
}
